# Cloudflare Pages Configuration

# API_BASE: Path to API functions (default: /api for Cloudflare Pages)
API_BASE="/api"

# Tree Node Color Configuration
# VITE_TREE_COLOR_LIGHTNESS_STEP: Lightness increase per level (default: 0.08)
VITE_TREE_COLOR_LIGHTNESS_STEP="0.08"
# VITE_TREE_COLOR_LEVELS_PER_HUE: Number of levels before hue shifts (default: 5)
VITE_TREE_COLOR_LEVELS_PER_HUE="5"
# VITE_TREE_COLOR_HUE_STEP: Hue increment when shifting colors (default: 60)
VITE_TREE_COLOR_HUE_STEP="60"