# Cloudflare Pages Configuration

# API_BASE: Path to API functions (default: /api for Cloudflare Pages)
API_BASE="/api"

# Tree Node Color Configuration
# VITE_NODE_LIGHTSTEP: Lightness increase per level (default: 0.08)
VITE_NODE_LIGHTSTEP="0.08"
# VITE_NODE_LEVELMAX: Number of levels before hue shifts (default: 5)
VITE_NODE_LEVELMAX="5"
# VITE_NODE_HUESIZE: Hue increment when shifting colors (default: 60)
VITE_NODE_HUESIZE="60"